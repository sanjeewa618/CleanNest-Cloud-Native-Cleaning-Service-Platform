# 1. Use a lightweight Node.js Alpine base image
FROM node:20-alpine

# OpenSSL & libc6-compat install කිරීම (Prisma engine එකට Alpine වල මෙය අනිවාර්යයි)
RUN apk add --no-cache openssl libc6-compat

# 2. Create and set the working directory inside the container
WORKDIR /app

# 3. Copy package files first and install dependencies
COPY package*.json ./
COPY prisma ./prisma/

RUN npm install

# 4. Generate the Prisma Client
RUN npx prisma generate

# 5. Copy the remaining source code and build the TypeScript application
COPY . .
RUN npm run build

# 6. Expose the backend port (Port 5000)
EXPOSE 5000

# 7. Start the production server
CMD ["npm", "start"]
